{
  "name": "sucopeku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "lint": "eslint . && prettier --check . && npm run check:citations",
    "check:citations": "tsx scripts/check-spec-citations.ts",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "infra:bootstrap": "cd infra && npx cdk bootstrap",
    "infra:deploy": "cd infra && npx cdk deploy --all",
    "infra:diff": "cd infra && npx cdk diff",
    "infra:outputs": "tsx scripts/outputs.ts",
    "deploy": "tsx scripts/deploy.ts",
    "teardown": "tsx scripts/teardown.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.1.2",
    "aws-cdk": "^2.173.0",
    "aws-cdk-lib": "^2.173.0",
    "constructs": "^10.4.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3"
  }
}
